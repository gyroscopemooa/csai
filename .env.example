# Copy to .env; local only, never commit secrets.
DEMO_MODE=1
# Shared test servers require Google OAuth; keep anonymous local demo disabled there.
SHARED_TEST_MODE=0
# Comma-separated verified identities only, e.g. google:12345678901234567890.
OPERATOR_OWNERS=
# Optional: comma-separated Google verified emails for operator access.
OPERATOR_EMAILS=
# Required only for localhost operator testing; generate a 24+ character random value.
LOCAL_OPERATOR_TOKEN=
APP_URL=http://127.0.0.1:8000
DATA_DIR=./data
# CS AI development Supabase project only. Do not reuse another service's keys.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
TRAIN_MODEL=gpt-6.2-sol
CHAT_MODEL=gpt-6-luna
# Verify reasoning support against the linked account before enabling live traffic.
TRAIN_EFFORT=low
CHAT_EFFORT=none
BOOKING_EFFORT=low
# Set only after confirming the selected model's actual rates. Existing fallbacks are estimates.
# TRAIN_INPUT_USD_PER_M=
# TRAIN_OUTPUT_USD_PER_M=
# TRAIN_CACHED_USD_PER_M=
# CHAT_INPUT_USD_PER_M=
# CHAT_OUTPUT_USD_PER_M=
# CHAT_CACHED_USD_PER_M=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production deployment is intentionally blocked until security, billing and integrations are verified.
# Optional integrations; generate encryption key using the command in README.
INTEGRATION_ENCRYPTION_KEY=
RESEND_API_KEY=
RESEND_FROM=
ENABLE_CHANNEL_WEBHOOKS=0
# Exact verified provider callback hostname(s), never wildcard or an arbitrary URL.
KAKAO_CALLBACK_HOSTS=
# Worker runs separately; keep both OFF until recipient and provider verification.
ENABLE_AUTO_EMAIL=0
ENABLE_LIVE_EMAIL=0

# Enable only one worker per database, after explicit integration setup.
ENABLE_BACKGROUND_WORKER=0
ENABLE_AUTO_CALENDAR=0

ENABLE_AUTO_REPORTS=0

# Generate and retain a single VAPID keypair; configure the private key as a secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
ENABLE_AUTO_PUSH=0
ENABLE_LIVE_PUSH=0

# Dedicated CS AI Supabase PostgreSQL session pooler connection, SSL required.
# Run supabase/migrations/002_private_runtime_bootstrap.sql first.
CSAI_DB_BACKEND=sqlite
DATABASE_URL=

# Custom hostname support, enable only after Cloudflare for SaaS routing is configured.
CANONICAL_APP_URL=https://csai.jeonmeensoo.workers.dev
ENABLE_CUSTOM_DOMAINS=0
ENABLE_AUTO_DOMAINS=0
CUSTOM_DOMAIN_TARGET=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
