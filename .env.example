# Copy to .env; local only, never commit secrets.
DEMO_MODE=1
# Shared test servers require Google OAuth; keep anonymous local demo disabled there.
SHARED_TEST_MODE=0
# Comma-separated verified identities only, e.g. google:12345678901234567890.
OPERATOR_OWNERS=
# Optional: comma-separated Google verified emails for operator access.
OPERATOR_EMAILS=
# Required only for localhost operator testing; generate a 24+ character random value.
LOCAL_OPERATOR_TOKEN=
APP_URL=http://127.0.0.1:3000
DATA_DIR=./data
# Optional: fill each new local anonymous demo workspace with removable sample chats.
SEED_UI_SAMPLES=0
# Draft policy UI remains test-only. Final text and entity/contact/data-flow details
# must be reviewed before setting both variables below in a production deployment.
POLICY_APPROVED_VERSION=
POLICY_ENFORCE=0
# Public operator identity. Fill with verified facts before enabling the final policy.
CSAI_BUSINESS_NAME=
CSAI_REPRESENTATIVE=
CSAI_BUSINESS_NUMBER=
CSAI_BUSINESS_ADDRESS=
CSAI_CONTACT_PHONE=
CSAI_CONTACT_EMAIL=
CSAI_MAIL_ORDER_NUMBER=
CSAI_PRIVACY_OFFICER=
CSAI_PRIVACY_EMAIL=
# Set only after the processor/country/data-flow disclosure and real refund rules
# are written into the published policy and reviewed against the deployed service.
CSAI_PRIVACY_FLOW_APPROVED=0
CSAI_REFUND_RULES_APPROVED=0
# CS AI development Supabase project only. Do not reuse another service's keys.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
TRAIN_MODEL=gpt-6.2-sol
CHAT_MODEL=gpt-6.2-sol
# Verify reasoning support against the linked account before enabling live traffic.
TRAIN_EFFORT=high
CHAT_EFFORT=low
BOOKING_EFFORT=low
# Standard API USD per 1M tokens, checked against official pricing on 2026-11-27.
# Recheck before live use; account access and actual billing tier still need verification.
TRAIN_INPUT_USD_PER_M=2.00
TRAIN_OUTPUT_USD_PER_M=10.00
TRAIN_CACHED_USD_PER_M=0.10
CHAT_INPUT_USD_PER_M=2.00
CHAT_OUTPUT_USD_PER_M=10.00
CHAT_CACHED_USD_PER_M=0.10
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production deployment is intentionally blocked until security, billing and integrations are verified.
# Optional integrations; generate encryption key using the command in README.
INTEGRATION_ENCRYPTION_KEY=
RESEND_API_KEY=
RESEND_FROM=
ENABLE_CHANNEL_WEBHOOKS=0
# Exact verified provider callback hostname(s), never wildcard or an arbitrary URL.
KAKAO_CALLBACK_HOSTS=
# Worker runs separately; keep both OFF until recipient and provider verification.
ENABLE_AUTO_EMAIL=0
ENABLE_LIVE_EMAIL=0

# Enable only one worker per database, after explicit integration setup.
ENABLE_BACKGROUND_WORKER=0
ENABLE_AUTO_CALENDAR=0

ENABLE_AUTO_REPORTS=0

# Generate and retain a single VAPID keypair; configure the private key as a secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
ENABLE_AUTO_PUSH=0
ENABLE_LIVE_PUSH=0

# Dedicated CS AI Supabase PostgreSQL session pooler connection, SSL required.
# Run supabase/migrations/002_private_runtime_bootstrap.sql first.
CSAI_DB_BACKEND=sqlite
DATABASE_URL=

# Custom hostname support, enable only after Cloudflare for SaaS routing is configured.
CANONICAL_APP_URL=https://csai.jeonmeensoo.workers.dev
ENABLE_CUSTOM_DOMAINS=0
ENABLE_AUTO_DOMAINS=0
CUSTOM_DOMAIN_TARGET=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Optional SOLAPI delivery: verified sender and approved Alimtalk template required.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
SOLAPI_ALIMTALK_PFID=
SOLAPI_ALIMTALK_TEMPLATE_ID=
ENABLE_AUTO_MESSAGES=0
ENABLE_LIVE_MESSAGES=0
POLAR_SANDBOX_CHECKOUT_ENABLED=0
POLAR_SANDBOX_TOKEN=
POLAR_SANDBOX_MONTHLY_PRODUCT_ID=
POLAR_SANDBOX_ONE_TIME_PRODUCT_ID=

# Opt in only after Naver live staff delivery verification; default disabled.
ENABLE_NAVER_STAFF_SEND=0

# Experimental human browser-to-browser calls. Keep disabled until secure-context,
# two-device, TURN/ICE connectivity and consent/retention checks pass.
ENABLE_WEB_CALLS=0

# Telegram private bot channel; requires HTTPS, existing webhook worker and encryption key.
ENABLE_TELEGRAM_CHANNEL=0
